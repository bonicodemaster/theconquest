# ============================================================
#  World Conquest Quiz — environment variables
# ============================================================
# The app now runs as a single Next.js project on Vercel,
# backed by Supabase (Postgres + Realtime). The legacy
# Socket.io server in `server/` is no longer required.
# ------------------------------------------------------------

# ---- Web (Next.js / Vercel) ----
# Public — exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Server-only — DO NOT prefix with NEXT_PUBLIC_
# Used by API routes to bypass RLS for authoritative writes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# ---- Optional / legacy ----
# Only relevant if you still run the deprecated Socket.io server.
# SERVER_PORT=4000
# CORS_ORIGIN=http://localhost:3000
# JWT_SECRET=replace-me-with-a-long-random-string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conquest?schema=public
